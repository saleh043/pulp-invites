# Copy this file to .env and add your bot token locally.
DISCORD_TOKEN=

# Optional: accounts younger than this many days count as fake invites.
FAKE_ACCOUNT_AGE_DAYS=7

# Discord user IDs allowed to use -resetinv @member, separated by commas.
# Example: INVITE_RESETTER_IDS=123456789012345678,987654321098765432
INVITE_RESETTER_IDS=
